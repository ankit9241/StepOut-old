# ==============================================================================
# StepOut Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas / Self-Hosted)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production or on Render), a real MongoDB connection is REQUIRED.
# Fallback to in-memory store is strictly disabled in production.
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/stepout?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stepout
MONGODB_DB_NAME=stepout

# Set to "false" to ensure missing/failed DB connections fail loudly instead of falling back
ALLOW_IN_MEMORY_DB=false

# ------------------------------------------------------------------------------
# 2. Open-Weight AI Inference (Gemma via Ollama)
# ------------------------------------------------------------------------------
# StepOut uses Google's open-weight Gemma model (gemma3:latest or gemma2:2b / gemma:2b).
#
# IMPORTANT FOR RENDER DEPLOYMENTS:
# Render web services cannot reach "localhost:11434" on your local computer.
# For production deployment on Render, choose one of the following for OLLAMA_BASE_URL:
#   Option A: Public / tunneled Ollama instance (e.g. Cloudflare Tunnel, ngrok, or tailscale)
#             OLLAMA_BASE_URL=https://my-ollama-tunnel.example.com
#   Option B: Dedicated cloud VM / GPU instance with Ollama installed
#             OLLAMA_BASE_URL=https://ollama.my-domain.com
#   Option C: Local development default
#             OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_TIMEOUT_MS=60000
# Optional: Bearer token when accessing a secured remote or tunneled Ollama proxy
OLLAMA_API_KEY=
# Local proxy configuration (used when running 'npm run proxy:ollama')
OLLAMA_PROXY_PORT=11435
OLLAMA_PROXY_TOKEN=

# ------------------------------------------------------------------------------
# 3. Audio & Voice Transcription
# ------------------------------------------------------------------------------
# StepOut includes free in-browser Web Speech API transcription for supported browsers (Chrome, Edge, Safari).
# If uploading audio files from non-browser clients or requiring server-side transcription,
# configure an OpenAI-compatible Whisper service:
TRANSCRIPTION_API_URL=
WHISPER_URL=

# ------------------------------------------------------------------------------
# 4. Nitro Engine / Deployment Runtime
# ------------------------------------------------------------------------------
# node-server is required for Render / Node.js runtime (supports mongodb driver & tesseract.js worker threads)
NITRO_PRESET=node-server
